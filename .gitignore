# ==========================================
# .gitignore for ET4244 Outcome Lab Project
# (VS Code, PyCharm, Arduino IDE, & Python)
# ==========================================

# ------------------------------------------
# Byte-compiled / Optimized Python Files
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ------------------------------------------
# Virtual Environments & Packages
# ------------------------------------------
venv/
.venv/
env/
.env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------
# VS Code (Visual Studio Code) Settings
# ------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ------------------------------------------
# PyCharm & JetBrains IDE Files
# ------------------------------------------
.idea/
*.iws
*.iml
*.ipr

# ------------------------------------------
# Arduino IDE Build & Cache Artifacts
# ------------------------------------------
# Arduino CLI / IDE 2.x temporary build folders
build/
.arduinoIDE/
*.hex
*.elf
*.bin
*.eep

# ------------------------------------------
# Project Lab Log Files & Exported Data
# ------------------------------------------
# Sensor output logs and CSV exports from PySerial runs
*.log
# Uncomment below if you wish to ignore generated CSV data files:
# *.csv

# ------------------------------------------
# Operating System Junk Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp